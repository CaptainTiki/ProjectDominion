[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 squares_color : source_color = vec4(0.000000, 0.000000, 0.000000, 0.000000);
uniform vec4 line_color : source_color = vec4(0.043137, 0.290196, 0.462745, 0.478431);
uniform float border_thickness = 0.01499999966472;
uniform float line_thickness = 0.07999999821186;
uniform float grid_cells = 30.0;



void fragment() {
// ColorParameter:15
	vec4 n_out15p0 = squares_color;


// ColorParameter:14
	vec4 n_out14p0 = line_color;


// FloatParameter:20
	float n_out20p0 = border_thickness;


// Input:2
	vec2 n_out2p0 = UV;


// VectorOp:18
	vec2 n_in18p0 = vec2(1.00000, 1.00000);
	vec2 n_out18p0 = n_in18p0 - n_out2p0;


// VectorOp:19
	vec2 n_out19p0 = min(n_out18p0, n_out2p0);


// VectorDecompose:25
	float n_out25p0 = n_out19p0.x;
	float n_out25p1 = n_out19p0.y;


// FloatOp:26
	float n_out26p0 = min(n_out25p0, n_out25p1);


// SmoothStep:21
	float n_in21p0 = 0.00000;
	float n_out21p0 = smoothstep(n_in21p0, n_out20p0, n_out26p0);


// FloatOp:24
	float n_in24p0 = 1.00000;
	float n_out24p0 = n_in24p0 - n_out21p0;


// FloatParameter:11
	float n_out11p0 = line_thickness;


// FloatParameter:3
	float n_out3p0 = grid_cells;


// VectorCompose:4
	vec2 n_out4p0 = vec2(n_out3p0, n_out3p0);


// VectorOp:5
	vec3 n_out5p0 = vec3(n_out2p0, 0.0) * vec3(n_out4p0, 0.0);


// VectorOp:27
	vec3 n_in27p1 = vec3(0.50000, 0.50000, 0.00000);
	vec3 n_out27p0 = n_out5p0 - n_in27p1;


// VectorFunc:6
	vec3 n_out6p0 = fract(n_out27p0);


// VectorFunc:8
	vec3 n_out8p0 = abs(n_out6p0);


// VectorDecompose:9
	float n_out9p0 = n_out8p0.x;
	float n_out9p1 = n_out8p0.y;
	float n_out9p2 = n_out8p0.z;


// FloatOp:10
	float n_out10p0 = min(n_out9p0, n_out9p1);


// SmoothStep:12
	float n_in12p0 = 0.00000;
	float n_out12p0 = smoothstep(n_in12p0, n_out11p0, n_out10p0);


// FloatOp:13
	float n_in13p0 = 1.00000;
	float n_out13p0 = n_in13p0 - n_out12p0;


// FloatOp:23
	float n_out23p0 = max(n_out24p0, n_out13p0);


// Mix:16
	vec4 n_out16p0 = mix(n_out15p0, n_out14p0, vec4(n_out23p0));


// Output:0
	ALBEDO = vec3(n_out16p0.xyz);
	ALPHA = n_out23p0;


}
"
